{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gig history",
  "description": "Attended events. Categories describe main/co-billed artists, not support acts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["events"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Location of the JSON Schema used to validate this file."
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "nonBlankString": {
      "type": "string",
      "pattern": "\\S"
    },
    "artists": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonBlankString"
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artists", "categories", "venue", "date", "city"],
      "properties": {
        "artists": {
          "$ref": "#/$defs/artists",
          "description": "Main/co-billed artists, excluding support acts."
        },
        "categories": {
          "description": "Category (or categories) of the show.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["comedy", "music"]
          }
        },
        "venue": {
          "$ref": "#/$defs/nonBlankString",
          "description": "Standardised venue name, with city stored separately."
        },
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Event date in YYYY-MM-DD format."
        },
        "city": {
          "$ref": "#/$defs/nonBlankString"
        },
        "support": {
          "$ref": "#/$defs/artists",
          "description": "Optional support acts. Omit when none are recorded."
        }
      }
    }
  }
}
